# Copy to .env.local and fill in. Never commit real values.

# --- App ---
# What this build is: development, preview or production.
NEXT_PUBLIC_APP_ENV=
# Canonical URL of the public site, including https://.
NEXT_PUBLIC_APP_URL=
# Host name of the public marketplace, without https://.
NEXT_PUBLIC_HOST_PUBLIC=
# Host name of the affiliate area, without https://.
NEXT_PUBLIC_HOST_AFFILIATE=
# Host name of the vendor area, without https://.
NEXT_PUBLIC_HOST_MERCHANT=
# Host name of the account area, without https://.
NEXT_PUBLIC_HOST_ACCOUNT=
# Host name of the admin area, without https://.
NEXT_PUBLIC_HOST_ADMIN=
# Cookie domain for cross-subdomain sessions; leave empty on vercel.app.
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Supabase ---
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key; server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ---
# Paystack secret key used to initialise and verify payments; server only.
# The prefix decides the mode: sk_test_ is test mode, sk_live_ is live mode.
PAYSTACK_SECRET_KEY=
# Paystack public key used by the browser checkout.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Paystack webhook signing secret (whsec_...), used to check the newer
# Paystack-Signature header. Optional: without it only the legacy
# x-paystack-signature header is checked.
PAYSTACK_WEBHOOK_SECRET=
# "true" makes the webhook route refuse any source address outside Paystack's
# published list. Anything else (or nothing) only logs a warning. The transfer
# approval route honours the same switch.
PAYSTACK_WEBHOOK_ENFORCE_IPS=
# The secret path segment of the transfer approval URL, for example
# https://app.affilova.com/api/paystack/transfer-approval/<token>. At least 32
# random URL-safe characters. Paystack documents no signature on that request,
# so this token is the only thing protecting it: generate it with
# `openssl rand -hex 24` and keep it out of git.
PAYSTACK_TRANSFER_APPROVAL_TOKEN=

# --- Cloudflare R2 ---
# Cloudflare account ID that owns the R2 bucket.
R2_ACCOUNT_ID=
# Access key ID of the R2 token used for uploads.
R2_ACCESS_KEY_ID=
# Secret access key of the R2 token used for uploads.
R2_SECRET_ACCESS_KEY=
# Name of the R2 bucket that stores uploaded files.
R2_BUCKET_FILES=

# --- Jobs ---
# Shared secret that authorises scheduled job endpoints; use 32+ random characters.
CRON_SECRET=

# --- Email ---
# Brevo API key used to send transactional email.
BREVO_API_KEY=
# From address on outgoing email.
EMAIL_FROM=
# Reply-to address on outgoing email.
EMAIL_REPLY_TO=

# --- Turnstile ---
# Cloudflare Turnstile site key rendered in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key used to verify tokens; server only.
TURNSTILE_SECRET_KEY=

# --- Malware scanner ---
# Base URL of the separate scanner service, e.g. https://scanner.example.com.
# It is called as POST <SCANNER_URL>/scan.
SCANNER_URL=
# Bearer token the scanner expects on every scan request; 32+ random characters.
SCANNER_SHARED_SECRET=
# Secret used to sign the scanner's callback: hex HMAC-SHA256 over
# "<timestamp>.<raw body>"; 32+ random characters.
SCANNER_CALLBACK_SECRET=

# --- Cloudinary ---
# Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key.
CLOUDINARY_API_KEY=
# Cloudinary API secret; server only.
CLOUDINARY_API_SECRET=

# --- Legacy, to be removed when replaced ---
# Postgres connection string currently used by the Neon client.
DATABASE_URL=
# Secret used to sign session tokens; required, at least 32 random characters.
JWT_SECRET=
# Google OAuth client ID for social sign-in.
GOOGLE_CLIENT_ID=
# Google OAuth client secret for social sign-in.
GOOGLE_CLIENT_SECRET=
# Squad secret key for the legacy payment flow.
SQUAD_SECRET_KEY=
# Squad public key for the legacy payment flow.
SQUAD_PUBLIC_KEY=

# --- Sentry ---
# DSN of the Sentry project. Public by design (it is sent to the browser).
# Leave empty to switch observability off: every Sentry call becomes a no-op.
NEXT_PUBLIC_SENTRY_DSN=
# The three below are optional and only for uploading source maps; not required.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Checkout delivery ---
# Secret that signs a buyer's download link (HMAC-SHA256). 32+ random
# characters. Rotating it invalidates every link already sent, and nothing else.
ORDER_ACCESS_SECRET=

# --- Payout screens ---
# Secret that keys the HMAC of the 6 digit code emailed before a bank change or
# a withdrawal. 32+ random characters; server only. Rotating it voids any code
# that has not been used yet, and nothing else.
STEP_UP_SECRET=

# --- Affiliate tracking ---
# Secret that salts the click hashes (HMAC-SHA256 with the UTC date, so the
# hashes rotate every day). 32+ random characters; server only. Rotating it
# makes every stored ip_hash and ua_hash unlinkable to new clicks, which is
# harmless: they are only used to count a unique click.
CLICK_HASH_SECRET=
