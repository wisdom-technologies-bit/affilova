# Copy to .env.local and fill in. Never commit real values.

# --- App ---
# What this build is: development, preview or production.
NEXT_PUBLIC_APP_ENV=
# Canonical URL of the public site, including https://.
NEXT_PUBLIC_APP_URL=
# Host name of the public marketplace, without https://.
NEXT_PUBLIC_HOST_PUBLIC=
# Host name of the affiliate area, without https://.
NEXT_PUBLIC_HOST_AFFILIATE=
# Host name of the vendor area, without https://.
NEXT_PUBLIC_HOST_MERCHANT=
# Host name of the account area, without https://.
NEXT_PUBLIC_HOST_ACCOUNT=
# Host name of the admin area, without https://.
NEXT_PUBLIC_HOST_ADMIN=
# Cookie domain for cross-subdomain sessions; leave empty on vercel.app.
COOKIE_DOMAIN=

# --- Supabase ---
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key; server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ---
# Paystack secret key used to initialise and verify payments; server only.
PAYSTACK_SECRET_KEY=
# Paystack public key used by the browser checkout.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Cloudflare R2 ---
# Cloudflare account ID that owns the R2 bucket.
R2_ACCOUNT_ID=
# Access key ID of the R2 token used for uploads.
R2_ACCESS_KEY_ID=
# Secret access key of the R2 token used for uploads.
R2_SECRET_ACCESS_KEY=
# Name of the R2 bucket that stores uploaded files.
R2_BUCKET_FILES=

# --- Jobs ---
# Shared secret that authorises scheduled job endpoints; use 32+ random characters.
CRON_SECRET=

# --- Email ---
# Brevo API key used to send transactional email.
BREVO_API_KEY=
# From address on outgoing email.
EMAIL_FROM=
# Reply-to address on outgoing email.
EMAIL_REPLY_TO=

# --- Turnstile ---
# Cloudflare Turnstile site key rendered in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key used to verify tokens; server only.
TURNSTILE_SECRET_KEY=

# --- Cloudinary ---
# Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key.
CLOUDINARY_API_KEY=
# Cloudinary API secret; server only.
CLOUDINARY_API_SECRET=

# --- Legacy, to be removed when replaced ---
# Postgres connection string currently used by the Neon client.
DATABASE_URL=
# Secret used to sign session tokens.
JWT_SECRET=
# Google OAuth client ID for social sign-in.
GOOGLE_CLIENT_ID=
# Google OAuth client secret for social sign-in.
GOOGLE_CLIENT_SECRET=
# Squad secret key for the legacy payment flow.
SQUAD_SECRET_KEY=
# Squad public key for the legacy payment flow.
SQUAD_PUBLIC_KEY=
